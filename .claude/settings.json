{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/herramientas/revisar-escritura.cjs\"",
            "timeout": 20,
            "statusMessage": "Revisando caracteres escondidos"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/herramientas/revisar-escritura.cjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(node armar.mjs)",
      "Bash(node pruebas/*)",
      "Bash(node herramientas/*)",
      "Bash(npm run verify)",
      "Bash(npm run verify:paralelo)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ]
  }
}
