  for (let i = 0; i < P.count; i++) {
    const k = clave(i);
    const s = mapa.get(k);
    if (s) { s[0] += N.getX(i); s[1] += N.getY(i); s[2] += N.getZ(i); s.push(i); } else mapa.set(k, [N.getX(i), N.getY(i), N.getZ(i), i]);
  }
  for (const s of mapa.values()) {
