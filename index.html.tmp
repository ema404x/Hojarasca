  { clave: 'mejoras', nombre: 'Mejoras con cristales' },
  { clave: 'forja', nombre: 'Forja de cristal' },
  { clave: 'base', nombre: 'Base' },
];
const RECETAS = [
  { id: 'lanza', cat: 'armas', nombre: 'Lanza de coihue', pide: { tronco: 1, piedra: 2 }, da: { cosa: 'lanza' }, unica: true,
