    v.z *= zBase * (v.z > 0 ? 1 + 0.08 * pecho : 0.96) * (v.y > 0.44 ? 0.88 : 1);
    v.x *= 1 + 0.1 * hombro;   // 3.5.2: el hombro un poco más ancho, tapa el arranque del brazo
  });
