    torso.add(capaHombro);
  }
  if (R.chaleco) {
    torso.add(capa(abrigo, [[0.167, -0.06], [0.166, 0.02], [0.156, 0.12], [0.171, 0.24], [0.197, 0.35], [0.211, 0.43], [0.2, 0.478]], 14, 0.42, Math.PI * 2 - 0.84));
    if (R.bombacha) {
