  }
  let prendido = false;
  function actualizar(dt) {
    actualizarJuntos(dt);
    avanzarArmado();
    acum += dt;
    if (acum < 0.5) return;
    acum = 0;
    repasar(true);
    if (!mundo.activo) { if (prendido) { apagar(); prendido = false; } return; }
    prendido = true;
    revisarJuntos();
