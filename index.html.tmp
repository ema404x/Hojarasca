    fisica(h) {
      h.circulo(0, CRUZ.z + 0.1, 0.07, -0.05, 1.7);
      h.segmento(GRILLA.x - GRILLA.ancho / 2, GRILLA.z, GRILLA.x + GRILLA.ancho / 2, GRILLA.z, GRILLA.fondo / 2, -0.05, GRILLA.y + 0.05);
      h.circulo(-1.3, 0.45, 0.24, -0.05, 0.6);
    },
