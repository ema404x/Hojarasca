      caballos: caballos.map((c) => ({ id: c.def.id, visible: c.m.g.visible })), gallinas: gallinas?.count || 0,
      cachorro: cachorro ? { x: cachorro.x, z: cachorro.z, visible: cachorro.m.g.visible, talla: cachorro.m.g.scale.x } : null,
    }),
