      const cuerda = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 0.26, 4), new THREE.MeshLambertMaterial({ color: SOGA }));
      cuerda.position.set(s * 0.12, -0.2, 0);
      cuerda.rotation.z = s * 0.45;
      roldana.add(cuerda);
    }
