      : `Leña: ${panel.est.lena === 1 ? 'un tronco' : `${panel.est.lena} troncos`} por fuego (tenés ${ctx.troncos?.() || 0}). Lo que sale va a la alacena.`);
    const ul = div.querySelector('ul');
