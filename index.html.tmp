    case 'brindar': {
      g.brazos[1].rotation.x = -1.55 + Math.sin(t * 2.2) * 0.06; g.brazos[1].rotation.z = 0.1;
      g.brazos[0].rotation.x = -0.2; g.cabeza.rotation.x -= 0.18;
