}
// Cuánto falta, en palabras (para la portada y el panel)
function textoAvance(d, def) {
  const h = d?.hoy?.fecha === def.fecha ? d.hoy : { avance: 0, hecho: false };
  if (h.hecho) return `Hecho: ${h.puntos} puntos`;
  if (def.tipo === 'pesca') return `${h.avance} de ${def.n}`;
  if (def.tipo === 'tren') return `${h.avance} de ${def.n}`;
  return 'Todavía no';
}

return { fechaTexto, fechaValida, diaAnterior, OBRAS_DEL_DIA, CIRCUITOS_DEL_DIA, PECES_DEL_DIA, TIPOS_DIARIO, PUESTA_DEL_SOL, desafioDelDia, diariosNuevo, sanearDiarios, hoyDe, rachaVigente, avanzarDiario, textoAvance };
