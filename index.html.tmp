    for (let d = c.cuenta + 1; d < hoy && vueltas < 400; d++, vueltas++) if (c.comio !== d && g.batea > 0) comerChanchos(g, d, eventos);
    c.cuenta = Math.max(c.cuenta, hoy - 1);
    if (c.comio !== hoy && g.batea > 0 && hoy >= c.desde) comerChanchos(g, hoy, eventos);
  }
