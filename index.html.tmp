      // que el delantal (así no lo atraviesa) y sobre el borde del chaleco
      torso.add(capa('#7a2e26', [[0.163, -0.05], [0.169, -0.038], [0.17, 0.028], [0.165, 0.042]], 16));
    } else torso.add(capa('#4a3626', [[0.168, -0.035], [0.168, 0.02]], 14));   // el cinto
  } else {
