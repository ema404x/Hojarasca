      opc.splice(8);
    } else if (tipo === 'amor-casa') {
      opc.push({ id: 'amor:convivir:refugio', titulo: FR.opcion.refugio });
      if (casaDeElla(clave)) opc.push({ id: 'amor:convivir:suya', titulo: FR.opcion.suya });
