return { HORA_ATAQUE, HORA_AMANECER, SALUD_MAX, claveNoche, esHoraDeAtaque, segundosHasta, relojCorto, TIPOS_ALIEN, NOCHE_JEFE, esNocheDeJefe, PUNTO_DEBIL, danoEnPuntoDebil, ALTURA_SALTO, NO_SALTABLES, puedeSaltar, DIFICULTADES, dificultad, composicionOleada, sinJefe, multiplicadorNoche, ARMAS, MEJORAS, armaEfectiva, CATEGORIAS_TALLER, RECETAS, REFUERZOS, NOCHE_FINAL, ESPECIALES, nocheEspecial, aplicarEspecial, PLANOS_ALIEN, nocheConRestos, efectoClima, vidaMaxObra, costoReparacion, suministrosDelAlba, COMPANEROS, desafioNuevo, NUCLEO_VIDA, sanearDesafio };
