    poseAlien.carrera = a.tipo === 'rastreador' && anda && dist > 7 && dist < 45 && a.frenoT <= 0;
    poseAlien.apuntando = !!def.aDistancia && dist < def.alcance && !anda;
    poseAlien.agazapado = !anda && !poseAlien.ataca && dist < 14;
