const etapaDeChico = (a, k) => chicoDe(a, k)?.etapa ?? (CHICOS_ALDEA.includes(k) ? ETAPA_INICIAL[k] : null);
const chicoAfuera = (a, k) => !!chicoDe(a, k)?.afuera;
