  }

  // ---------------------------------------------------------------- cada cuadro
  let acum = 0;
  function apagar() {
    for (const id of [...figuras.keys()]) quitarFigura(id);
    if (juntos) { soltarNpc(juntos.npc); juntos = null; }
    if (madreConBebe) { bebeEnBrazos(madreConBebe, false); madreConBebe = null; }
    for (const n of copas) darCopa(n, false);
