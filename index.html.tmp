    if (incluirSoto) for (const m of matasCerca(x, z, radio + 1)) { const dx = m.x - x, dz = m.z - z; if (dx * dx + dz * dz < radio * radio) quitar(m); }
    return sacados;
  }

  // ---------------------------------------------------------------- talar y rebrotar
