        for (const s of [-1, 1]) c.agregar(new THREE.BoxGeometry(0.12, 1.6, 0.12), { color: MADERA, tipo: 0, matriz: matriz([x, 0.85, s * 0.35], [s * 0.25, 0, 0]) });
