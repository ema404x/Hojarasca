      for (const x of [-0.5, 0.5]) c.agregar(new THREE.CylinderGeometry(0.015, 0.015, 5.9, 4), { color: '#c9b894', tipo: 0, matriz: matriz([x, 2.6, 0], [Math.PI / 2, 0, 0]) });
