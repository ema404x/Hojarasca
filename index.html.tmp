        if (c.obra && Math.hypot(npc.pos.x - c.obra.datos.x, npc.pos.z - c.obra.datos.z) < 2.4) {
          const lleno = api.reparar(c.obra, 7 * dt);
          c.golpe = (c.golpe || 0) - dt;
