    const nombreCambio = d.nombre !== personal.nombre || (d.nombre && letraSobre(d.casco) !== letraSobre(personal.casco));
    if (nombreCambio || (!nombres.length && d.nombre)) {
      for (const n of nombres) { barco.remove(n); desechar(n); }
      nombres = [];
