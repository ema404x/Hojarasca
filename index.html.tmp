    saludoAmigo: 'Buen día, {nombre}. ¿Algún avistaje para el registro?',
    saludoCompadre: '¡{nombre}! Vos ya sos guardaparque honoraria… u honorario. Lo que prefieras.',
    fauna: 'En la recorrida de esta mañana vi {unbicho}. Ya está en el registro.',
    pronostico: 'Por cómo están los cóndores, te diría {pronostico}.',
    regalo: 'Julia, la guardaparque, te dejó piñones del pehuén viejo',
