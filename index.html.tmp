  const aplicar = () => { try { ctx.aplicarMejoras?.(tren()); } catch (err) { console.warn('[taller] aplicarMejoras', err); } };

  // ---------------------------------------------------------------- el reloj
  let acum = 1;
  let aplicadoUnaVez = false;
  function actualizar(dt) {
    if (!activo()) return;
    if (!aplicadoUnaVez) { aplicadoUnaVez = true; aplicar(); }
    acum += dt;
