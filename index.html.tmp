      poseAlien.reflejo = reflejoOjos({ encendida: true, cosLinterna: cosL, angulo: luzJugador.angulo, distancia: dl, alcance: luzJugador.alcance, frente, noche: nocheNivel });
      a.reflejo = poseAlien.reflejo;
