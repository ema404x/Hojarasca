const CASAS_CANDIDATAS = Object.fromEntries(Object.keys(CANDIDATAS).map((k) => [k, casaDeElla(k)]));

return { aMundoMarco, aLocalMarco, miraMundo, REFUGIO, PUNTOS_REFUGIO, SILLA_REFUGIO, MESA_REFUGIO, CUARTO, PUNTOS_CUARTO, MUEBLES_CUARTO, cuartoDe, marcoCuarto, LARGO_ACOSTADO, puntoCuarto, TALLA_HIJO, figuraHijo, puntoRefugio, llegadaRefugio, llegadaValle, puntoCitaValle, MOMENTO_CITA, SALIDA_CITA, destinoPareja, entradaRefugio, destinoHijo, cuartoVisible, BODA, escenaBoda, JUNTOS, puedeCaminar, FRASES_JUNTOS, FRASES_MANANA, FRASES_FIESTA, JUEZ, esNocheDeChicos, CASAS_CANDIDATAS };
})();

// ===== amor-mundo.js =====
const __mod_amor_mundo = (() => {
