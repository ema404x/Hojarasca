    sinLugar = 0;
    if (armando && (!figuras.has(armando.id) || figuras.get(armando.id) !== armando)) armando = null;
    if (!armando) armando = [...figuras.values()].find((f) => !f.npc && f.querida) || null;
    if (!armando) return;
