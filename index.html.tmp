  const fs = lista.map(([y0, y1, h]) => [y0, y1, new THREE.Color(h)]);
  return (c, p) => { for (const [y0, y1, h] of fs) if (p.y >= y0 && p.y <= y1) { c.copy(h); return; } };
}
