    const deBuenAnimo = !!ellaN && niki > 0 && d === niki + 1 && h < 12;
    if (sonrie && (sonrie !== ellaN || !deBuenAnimo)) { if (sonrie.__gesto === 'sonrisa') sonrie.__gesto = null; sonrie = null; }
    if (deBuenAnimo && !ellaN.__gesto) { ellaN.__gesto = 'sonrisa'; sonrie = ellaN; }
