  function actualizarNave(dt) {
    if (!nave.g.visible) return;
    estadoNave.t += dt;
    const e = estadoNave;
    let alto = e.y;
    if (e.fase === 'llegando') {
      alto = e.y + Math.max(0, 1 - e.t / 4) ** 2 * 260;
      if (e.t > 4) { e.fase = 'bajando'; e.t = 0; e.ritmo = 0; }
    } else if (e.fase === 'bajando') {
