    // 3.0: la corrida sin fin (ver desafio-supervivencia.js) y el mapa de la semilla (desafio-mapa.js)
    sinFin: x.sinFin && typeof x.sinFin === 'object' && !Array.isArray(x.sinFin) ? { terminada: !!x.sinFin.terminada } : null,
