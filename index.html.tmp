    if (!mundo.activo || t > j.hasta || horas() >= 22 || (c && c.clave === j.clave && c.estado === 'acordada' && c.dia === dia() && horas() >= c.desde - 0.5) || mundo.boda?.hoy) terminarJuntos(t > j.hasta || horas() >= 22);
  }
