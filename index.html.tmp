    ventanas: [{ cara: 'frente', x: 2.0, ancho: 0.9, alto: 1.0 }, { cara: 'izq', z: 1.0, ancho: 0.8, alto: 1.0 }, { cara: 'der', z: 0.6, ancho: 0.9, alto: 1.0 },
