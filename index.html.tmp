  negro: '#2e3133', humo: '#1f1d1b', rojo: '#9a3324', rojoOscuro: '#6e2219', crema: '#e4d3a6', bronce: '#c0913e',
  acero: '#7a766e', aroBlanco: '#dcd5c4', hierro: '#3b3733', madera: '#8d4a2e', maderaClara: '#a8683e', marco: '#5a2c1c',
