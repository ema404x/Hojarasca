      for (const y of [0.15, 0.48, 0.81]) c.agregar(new THREE.TorusGeometry(0.37, 0.025, 4, 16), { color: '#3f3a34', tipo: 4, matriz: matriz([0, y, 0], [Math.PI / 2, 0, 0]) });
