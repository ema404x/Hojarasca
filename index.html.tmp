    const ondula = circFbm(a, 1.6, r * 0.0009, 3.1, 3) * 0.5 + 0.5;
    return 18 + smoothstep(560, 1700, r) * (40 + 70 * ondula) * (0.7 + 0.3 * ladoAlto(a)) + smoothstep(2600, 3800, r) * 60;
  };
