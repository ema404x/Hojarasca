const tieneDe = (o, k) => objeto(o) && Object.hasOwn(o, k);
function hashTexto(s) {
  let h = 2166136261;
  for (const ch of String(s)) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; }
