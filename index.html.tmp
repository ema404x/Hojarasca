// ===== vida.js =====
const __mod_vida = (() => {
// Más vida en el bosque: huemules, zorros, cisnes, patos de los torrentes, martines pescadores,
// picaflores, bandurrias y truchas que saltan con poca luz

const { rng, lerp, clamp } = __mod_ruido;
const { LAGO, LIMITE } = __mod_config;
const { perfilHabitatPatagonico } = __mod_patagonia;
const { percepcionMamifero, firmaSonoraJugador, calmaDe, puntoDeCuriosidad, CURIOSIDAD, anotarAcercamiento } = __mod_percepcion;
const { publicarAnimal, animalMasCercano, destinoEscapeConCobertura, actividadFaunaPatagonica } = __mod_ecosistema;
const { crearSombraContacto, actualizarSombraContacto } = __mod_naturaleza_reactiva;
const { actualizarMicroconducta, gestoMicroconducta } = __mod_microconductas;
const { crearPoolPosicional, limitarSombrasPorDistancia, consumirPresupuestoIA } = __mod_rendimiento;
