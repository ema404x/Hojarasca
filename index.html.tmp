const ETAPAS_AMOR = ['conocidos', 'coqueteo', 'saliendo', 'novios', 'comprometidos', 'casados', 'separados'];
const idx = (e) => ETAPAS_AMOR.indexOf(e);
const AMOR = {
  tope: 100,
