      if (compactoRecien) mediosPendientes = 2; else compactarMedios(cam);
    }
    for (const ch of chunks.values()) {
      const d = Math.max(0, Math.hypot(cam.x - ch.x, cam.z - ch.z) - TAM_CHUNK * 0.7);
