  'taller-arte': { adentro: [2.1, 1.45, PI], cliente: [1.15, 1.25, 1.4], cama: [1.92, -1.66, 1.78], 'lugar-1': [-0.6, 1.95, PI - 0.5] },
  ceramica: { adentro: [1.3, 1.88, PI], cliente: [0.2, 1.6, PI / 2], cama: [-1.92, -1.66, -1.78] },
