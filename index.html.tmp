        else alb = mix(alb, cg, t.a);
      }
      if (tela) {
        float suc = 1.0 - smoothstep(0.05, 0.5 + 0.3 * nT(uvp * 3.0), vPosT.y);
        alb = mix(alb, alb * vec3(0.6, 0.52, 0.42), suc * 0.6);
      }
      diffuseColor.rgb = alb * det;
