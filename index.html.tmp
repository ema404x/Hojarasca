  opcion: {
    piropo: 'Tirarle un piropo', mimo: 'Decirle algo lindo', cita: 'Invitarla a salir…', flores: 'Regalarle un ramo de flores', declararse: '¿Querés ser mi novia?',
    proponer: 'Proponerle casamiento (con el anillo)', convivir: 'Proponerle vivir juntos…', casa: '¿Dónde vivimos?…', chicos: 'Hablar de los chicos', buscar: '¿Y si buscamos un hijo?',
    niki: 'Ñiki ñiki…', reconquistar: 'Pedirle volver', refugio: 'En mi refugio', suya: 'En tu casa', volver: 'Mejor no',
    carta: 'Mandarle una carta de amor a {ella}', ramo: 'Mandarle un ramo de flores a {ella}', anillo: 'Encargarle un anillo (con un canto rodado)', retirar: 'Retirar el anillo',
  },
  // lo que dice ella o lo que pasa
  yaHoyPiropo: '¡Ya me dijiste algo lindo hoy! No gastes todo de una vez.',
  enojada: ['No tengo ganas de hablar de eso. Todavía estoy enojada.', 'Dejame, que todavía me dura el enojo.'],
  noPuedeCita: 'Ya tenemos una cita pendiente. Primero esa, ¿no?',
  sinHueco: 'Hoy y mañana no tengo un rato libre para eso. Otro día, ¿dale?',
  citaAcordada: 'Quedamos: {cita}, el {dia} a las {hora}. No llegues tarde.',
  citaHoy: 'Quedamos: {cita}, hoy a las {hora}. No llegues tarde.',
  citaManiana: 'Quedamos: {cita}, mañana a las {hora}. No llegues tarde.',
  citaEmpieza: ['¡Viniste! Ya pensaba que me ibas a dejar plantada.', '¡Hola! Llegaste justo.'],
  citaFin: ['Qué lindo rato. Gracias por invitarme.', 'Me la pasé muy bien. Hay que repetirlo.'],
  plantada: 'Te esperé un buen rato… Otra vez avisá, ¿sí?',
  sinFlores: 'En invierno no hay flores en el monte. Mandale una carta, que también llega.',
  yaFlores: '¡Si ya me regalaste flores hoy! Vas a tener que hacerme un florero.',
  noTodavia: 'Esto recién empieza. Salgamos un poco más antes de hablar de eso, ¿sí?',
  sinAnillo: 'Para eso te falta el anillo. Anselmo los hace con un canto rodado del arroyo.',
  convivirSi: 'Sí. Dale. Vivamos juntos.',
  convivirNo: 'Todavía no. Me gusta mi casa. Dame un poco más.',
  casaElegida: { refugio: 'Al refugio, entonces. Llevo mis cosas de a poco: una caja por día.', suya: 'Acá, entonces. Te hago lugar en el ropero. Un poquito, eh.' },
  chicosHoy: 'Hoy ya hablamos de eso. Mañana seguimos, que me da cosa.',
  buscarSi: 'Sí. Busquemos un hijo. Si viene, que venga con salud.',
  buscarNo: 'Todavía no. Primero casémonos, y después vemos.',
  buscarYa: 'Ya lo estamos buscando. Las cosas llegan cuando llegan.',
  maximoHijos: 'Con dos ya tenemos la casa llena. ¡Y el corazón también!',
  embarazo: '{ella} te dice al oído que va a tener un bebé. Faltan unos {dias} días.',
  esperando: 'Ya falta poco: unos {dias} días. A la noche se mueve como un pez.',
  nikiAntes: ['Los chicos ya duermen… ¿Apagamos la luz?', '¿Nos vamos a dormir? Bueno, a dormir dormir no…'],
  nikiSinChicos: ['¿Apagamos la luz?', '¿Nos vamos a dormir? Bueno, a dormir dormir no…'],
  nikiNo: { dia: 'Shh, ¿de día? Esperá que sea de noche.', chicos: 'Los chicos todavía andan despiertos. Más tarde.', casa: 'Acá no. En casa.', hoy: 'Hoy ya, ¿eh? Ahora a dormir de verdad.', enojada: 'Hoy no. Todavía estoy enojada con vos.' },
  nikiDespues: 'Un rato de mimos. Descansás de verdad y amanecés de buen ánimo.',
  reconquistaSi: 'Bueno… sí. Volvamos a intentarlo. Pero esta vez no me descuides.',
  reconquistaNo: 'Todavía no. Me lastimaste. Seguí viniendo, que a lo mejor…',
  reconquistaTodavia: 'Primero salgamos de nuevo, como al principio. Después vemos.',
  separacion: '{ella} se cansó de esperarte y se volvió a su casa con los chicos. «Si querés arreglarlo, vas a tener que venir a buscarme.»',
  separacionSinChicos: '{ella} se cansó de esperarte y se volvió a su casa. «Si querés arreglarlo, vas a tener que venir a buscarme.»',
  corto: '{ella} te dejó: «Si no venís nunca, esto no es un noviazgo».',
  seEnfrio: 'Con {ella} la cosa se enfrió: hace días que no la ves.',
  descuido: 'Hace días que no ves a {ella}. Te extraña.',
  vuelven: '¡{ella} y vos vuelven a estar juntos!',
  // el correo (Benigno en la estafeta y Ercilia en el almacén)
  correo: {
    carta: 'Una carta de amor para {ella}. La mando con el tren de mañana. Tranquilo, que no la leo. Bueno, no mucho.',
    ramo: 'Un ramo para {ella}. Le pongo un poco de agua en el frasco y va con el tren de mañana, como un pasajero más.',
    yaHoy: 'A {ella} ya le mandaste algo hoy. No la vas a tapar de correspondencia, ¿no?',
    sinFlores: 'En invierno no hay flores, che. Mandale una carta, que abriga igual.',
    entregada: { carta: 'Tu carta le llegó a {ella}', ramo: 'Tu ramo le llegó a {ella}' },
    entregadaSub: 'Con el tren de la mañana',
  },
  // Anselmo, el herrero
  anillo: {
    pide: 'Un anillo. Con un canto rodado del arroyo, ¿no? Lo pulo hasta que brille como un ojo de agua. En tres días está.',
    sinCanto: 'Para un anillo necesito un canto rodado del arroyo. Uno lindo, liso. Traeme uno y te lo hago.',
    sinNovia: 'Un anillo es cosa seria, muchacho. Primero tené novia, después hablamos.',
    haciendo: 'El anillo todavía está en la fragua. Pocha dice que lo pulo demasiado. Mañana o pasado está.',
    listo: 'Acá está tu anillo. Pocha lloró cuando lo vio. Yo no, eh. Se me metió una chispa en el ojo.',
    yaTenes: 'Ya tenés el anillo. Ahora el que tiene que hacer algo sos vos.',
    avisoListo: 'Anselmo terminó el anillo', avisoListoSub: 'Pasá a buscarlo por la herrería',
  },
  // el casamiento civil (el juez de paz llega en el tren de la mañana; nada religioso)
  boda: {
    fecha: 'Nos casamos el {dia}, a las once, en la biblioteca popular. El juez de paz viene en el tren de la mañana.',
    aviso: 'Hoy te casás con {ella}', avisoSub: 'A las once, en la biblioteca popular',
    escena: [
      'El juez de paz de Esquel se acomoda los anteojos y abre el libro de actas. Ernesto y Pocha son los testigos.',
      '«Estamos acá para unir en matrimonio a dos vecinos de la Aldea de los Duendes. ¿Quieren decir algo?»',
    ],
    si: '«Sí, quiero.» Ella también dice que sí, y la biblioteca entera aplaude. Pocha llora a moco tendido.',
    firma: 'Firman el acta. Afuera, Cholo arranca con un chamamé y la abuela Herminia tira arroz como si fuera nieve.',
    postergada: '{ella} te esperó en la biblioteca con el juez de paz y no viniste. El casamiento pasó para el {dia}.',
    avisoCasados: 'Te casaste con {ella}', avisoCasadosSub: 'Ahora decidan dónde viven',
  },
  // los hijos
  hijos: {
    nacio: '¡Nació {hijo}!', nacioSub: 'La mamá y {hijo} están bien. La casa suma un cuarto',
    crecio: { chico: '{hijo} ya camina y habla hasta por los codos', adolescente: '{hijo} ya es adolescente y se encierra en su cuarto', joven: '{hijo} ya es grande: elige su oficio' },
    charla: {
      bebe: ['{hijo} anoche se despertó tres veces. Pero cuando se ríe, se me pasa todo.', '¿Viste cómo te agarra el dedo {hijo}? No te suelta más.'],
      chico: ['{hijo} preguntó por qué el cielo es celeste. Le dije que te pregunte a vos.', '{hijo} juntó doce piedras en el arroyo y dice que una es un huevo de dinosaurio.'],
      adolescente: ['{hijo} anda con cara de que todo le da vergüenza. Sobre todo nosotros.', '{hijo} quiere que lo dejemos ir solo al lago. Yo digo que sí, pero con vos.'],
      joven: ['{hijo} ya trabaja de lo suyo. A veces lo miro y no lo puedo creer.', '¿Te acordás cuando {hijo} no llegaba a la mesa? Ahora hay que agacharse para darle un beso.'],
    },
    nombres: { nene: ['Lautaro', 'Tomás', 'Ramiro', 'Lihuel', 'Joaquín', 'Facundo', 'Benjamín', 'Ignacio'], nena: ['Malén', 'Catalina', 'Pilar', 'Rayén', 'Julieta', 'Lucila', 'Amancay', 'Clara'] },
  },
  // las habilidades que te enseña tu esposa
  habilidad: { aviso: 'Aprendiste de {ella}: {nombre}', avisoSub: '{texto}' },
  // lo que comentan los vecinos (con humor) cuando se enteran
  comentario: {
    novios: ['Así que vos y {ella}… ¡Ya me enteré! En esta aldea todo se sabe antes de que pase.', '¿Es verdad lo de {ella}? ¡Qué lindo! Ya era hora de que alguien se animara.'],
    comprometidos: ['¡Me dijeron que te casás con {ella}! ¿Me invitan? Más vale que me inviten.', 'Así que hay anillo. Anselmo no habla de otra cosa. Bueno, tampoco habla mucho.'],
    casados: ['¡Felicidades, recién casado! Se te nota en la cara: andás como bobo.', '¡Qué linda la fiesta! Todavía me duelen los pies de bailar.'],
    nacio: ['¡Felicidades por {hijo}! Dicen que tiene tu nariz. Pobre criatura. ¡Es un chiste!', '¡Un bebé en la aldea! Ya le estoy tejiendo unos escarpines.'],
    separados: ['Me enteré de lo de {ella}. Ánimo, que todo tiene arreglo. Casi todo.'],
    volvieron: ['¡Volviste con {ella}! Ya sabía yo. El que se va, vuelve.'],
    'dos-a-la-vez': ['Así que andás con {ella} y con {otra}… Mirá que la aldea es chica, eh. Muy chica.', 'Me contaron que salís con dos. ¿Vos te pensás que acá no se ve todo desde el almacén?'],
    cita: ['Te vi con {ella} en {lugar}. Muy acarameladitos. No digo nada, eh.', '¿Era {ella} la que estaba con vos en {lugar}? No, no pregunto nada. Bueno, sí.'],
  },
  // los chismosos le ponen más ganas
  chisme: {
    novios: ['¡Mirá quién viene! El novio de {ella}. Contame todo, que no se lo digo a nadie. Bueno, a Ercilia sí.'],
    'dos-a-la-vez': ['Escuchame una cosa: {ella} y {otra} se cruzaron en la vereda y no se saludaron. ¿Sabés algo de eso? Porque yo sí.'],
    cita: ['¡Te vi en {lugar} con {ella}! Medio pueblo te vio. El otro medio se enteró por mí.'],
  },
  // para la radio y el diario de la aldea (3.7.4): una línea con humor por cada novedad
  radio: {
    novios: 'Novedades del corazón: {ella} y nuestro vecino del refugio andan de novios. Los vieron tomados de la mano frente al almacén.',
    comprometidos: 'Atención, aldea: hay anillo. Anselmo lo hizo con un canto rodado y Pocha jura que no lloró. Lloró.',
    casados: 'Se casaron {ella} y el vecino del refugio. El juez de paz se llevó torta para el viaje de vuelta.',
    nacio: 'Llegó {hijo}, el vecino más chico de la aldea. Pesó lo que pesa un buen zapallo.',
    separados: 'Se separaron {ella} y el vecino del refugio. Desde esta radio, ánimo a los dos.',
    volvieron: 'Volvieron {ella} y el vecino del refugio. La aldea respira aliviada y Pocha también.',
    'dos-a-la-vez': 'Un vecino del refugio sale con {ella} y con {otra} a la vez. Se le recomienda abrigarse: va a hacer frío.',
