  ];
  const dormidos = [
    { tipo: 'rastreador', x: -0.9, z: 7.6 + azar() * 1.5 },
    { tipo: azar() < 0.5 ? 'saltador' : 'rastreador', x: 0.9, z: 9.2 + azar() * 1.5 },
