      pl.push(deformar(bola(plata, [0.0026, 0.0048, 0.0008], [x, F.cy + ytop - largo * 0.78, z + 0.0008], [-0.12, 0, 0], [7, 5]), (v) => { v.x *= 1 - 0.35 * Math.max(0, v.y); }));
    }
  }
