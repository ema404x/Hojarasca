        alb = mix(alb, alb * vec3(0.68, 0.5, 0.38), m.b * 0.8 * pecas);
        // las arrugas (la risa en los grandes; la frente, las ojeras y el surco en los mayores) y la cicatriz
        vec4 a = unoA(vec2(1024.0, 1024.0), vec2(512.0), uc);
