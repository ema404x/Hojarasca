// va por +z, de la entrada (z = 0) al fondo.
const RUINA = { ancho: 3.4, largo: 17, tabiques: [5.8, 11.6], puerta: 1.5, alto: 2.4 };
function disposicionRuina(azar = Math.random) {
  const placas = [
    { x: (azar() - 0.5) * 1.2, z: 2.9 },
    { x: (azar() - 0.5) * 1.2, z: 8.7 },
