    corderos: (n) => [n === 1 ? 'Nació un cordero' : `Nacieron ${n} corderos`, 'En la paridera de tu corral'],
    lechones: (n) => [`La chancha tuvo ${n} lechones`, 'En la casilla del chiquero'],
