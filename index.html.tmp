  reconquista: { minimo: 55, citas: 1 },
};
const sumarAfecto = (f, n) => { f.afecto = acotar(Math.round((f.afecto + n) * 10) / 10, 0, AMOR.tope); };

// ---------------------------------------------------------------- las habilidades (lo que te enseña tu esposa)
