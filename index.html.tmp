    resumen: 'Pescar dos truchas después de las 19:00.',
    listo: 'Esa es la hora. El resto del día se pesca; a esa hora se saca.',
    premio: { cosa: 'mosca', texto: 'una mosca atada a mano' },
    cumplido: (p) => (p.pescaTarde || 0) >= 2,
