  musico: {
    encanta: {
      empanadas: '¡Empanadas! Esto es lo que se come en un baile, entre chamamé y chamamé. Gracias, hermano.',
      yerba: 'Yerba. El mate y la guitarra son el mismo instrumento: los dos se pasan de mano en mano.',
      'pan-casero': 'Pan casero. Con un poco de dulce, después de tocar toda la noche, es lo mejor que existe.',
    },
    gusta: '{cosa}. ¡Gracias! Te debo una canción.',
    noGusta: '¿Habas? Ay, no. Me caen pesadas y después no puedo cantar. Perdoname.',
    ocupado: 'Estoy ensayando para el sábado. Si paro, se me olvida el arreglo. Más tarde, ¿dale?',
    acepta: '¡Vamos! Llevo la guitarra, por si se arma algo. A {lugar}.',
    animo: {
      bien: 'Bien. Me salió un arreglo nuevo para una cueca vieja.',
      cansado: 'Cansado. Toqué hasta las tres de la mañana y todavía me zumban los oídos.',
      inquieto: 'Con ganas de salir a buscar música. Los pájaros de acá tienen cada melodía…',
      charla: 'Con ganas de charlar. Un músico sin público es un loro en una jaula.',
    },
    historia: { titulo: 'Las canciones de mi viejo', partes: [
      'Nací en Corrientes, en un rancho donde siempre había una verdulera sonando. Me subí al tren hacia el sur a los veinte, con la guitarra y nada más.',
      'Toqué en bailes de galpón, en fiestas de esquila, en casamientos donde no conocía a nadie. Al final de la noche ya era de la familia.',
      'Mi viejo era músico y nunca grabó un disco. Las canciones que sé son de él, y yo se las enseño a quien quiera. Mientras alguien las toque, él sigue tocando.',
