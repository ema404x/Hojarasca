        [-largo / 2, -ancho / 2, largo / 2, -ancho / 2], [largo / 2, -ancho / 2, largo / 2, ancho / 2],
        [largo / 2, ancho / 2, -largo / 2, ancho / 2], [-largo / 2, ancho / 2, -largo / 2, -ancho / 2],
