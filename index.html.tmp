const { sanearMecanicas, mecanicasNuevas } = __mod_aldea_mecanicas;
// 3.7.0: la vida de la aldea (calendario, visitantes, mascota, apodo, familia, cartas) y su ritmo
const { sanearVidaAldea, vidaNueva, sanearRitmo } = __mod_aldea_vida;
// 3.7.1: el amor en la aldea (y el ajuste para apagarlo)
const { sanearAmor, amorNuevo, sanearAjusteRomance } = __mod_amor;
