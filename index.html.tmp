    torso.add(capaHombro);
    torso.add(capa(matiz(abrigo, 0.88), [[0.084, 0.535], [0.086, 0.572], [0.075, 0.586]], 14, 0, Math.PI * 2, 0.95));   // el cuello
  }
  if (R.pollera) {
