// cocina a leña de hierro, con su caño hasta el cielorraso (el de afuera lo pone el casco)
function tuboCocina(x, z, giro) { const F = marcoLocal(x, z, giro); const p = F.p(0.26, 0, -0.18); return { x: p[0], z: p[2] }; }
