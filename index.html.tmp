  if (objeto(v.vaca)) {
    g.vaca = { id: id(v.vaca.id), pelaje: PELAJES.includes(v.vaca.pelaje) ? v.vaca.pelaje : 'negra', desde: fecha(v.vaca.desde), ordenada: tope(ent(v.vaca.ordenada, 0), 0, hoy), lugar: sanoLugar(v.vaca.lugar) };
  }
