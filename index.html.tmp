  g.batea = tope(ent(v.batea, 0), 0, GRANJA.batea);
  g.corderos = (Array.isArray(v.corderos) ? v.corderos : []).filter(objeto).slice(0, GRANJA.corderos).map((c) => ({ id: id(c.id), nacio: fecha(c.nacio), madre: ent(c.madre, 0) === 1 ? 1 : 0 }));
