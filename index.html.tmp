        for (const lado of [-1, 1]) {
          const n = cartelNombre(d.nombre, 0.6, 0.11, { ancho: 512, alto: 100, tinta: letraSobre(d.casco), fuente: 'Caveat', peso: 700 });
          n.position.set(lado * 0.64, 0.24, 1.1);
