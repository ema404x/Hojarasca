  };
}
function sanearObra(lote, o, hoy = TOPE_DIA) {
  const x = objeto(o) ? o : {};
  const etapa = Math.max(etapaInicial(lote), Math.min(ETAPAS_OBRA.length - 1, entero(x.etapa, etapaInicial(lote))));
  const pide = pideEtapa(lote, etapa);
