    deMano(bola(colMano, [0.026, 0.058, 0.024], [-0.02, -0.062, 0.024], [0, 0, 0.05], [12, 9])),                // los dedos cerrados
    deMano(bola(colMano, [0.012, 0.03, 0.014], [-0.008, -0.026, 0.034], [0.25, 0, -0.6], [9, 7])),             // el pulgar, encima
