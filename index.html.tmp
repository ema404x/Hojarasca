    NA.setXYZ(i, ...n.clone().lerp(v, w * 0.85).normalize().toArray());
    const k = mejor / 3, previo = cambiosB.get(k);
    if (!previo || previo.w < w) cambiosB.set(k, { w, n: n.clone() });
