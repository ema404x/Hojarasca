    if (!L) return null;
    if (L.aldea) {
      const p = puntosMundo(L.aldea.edificio)[L.aldea[quien]];
      return p ? { x: p.x, z: p.z, mira: p.rot } : null;
    }
    const v = ctx.lugarValle?.(L.valle);
