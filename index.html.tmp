      const largo = 0.012 + (i === 0 ? 0.004 : 0) - Math.abs(i) * 0.0008;
      const argolla = new THREE.Mesh(new THREE.TorusGeometry(0.0022, 0.0006, 4, 8), color(plata)); argolla.position.set(x, F.cy + ytop, z - 0.0005); argolla.rotation.y = 0.2 * i;
      pl.push(argolla);
