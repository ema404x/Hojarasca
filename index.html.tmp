const { sanearCarreras } = __mod_carreras;
const { sanearDiarios } = __mod_diarios;
// 3.1: la historia guiada y los eventos del valle
const { sanearHistoria } = __mod_historia;
const { sanearEventosValle } = __mod_eventos_valle;
// 3.1: rangos y oficios
const { sanearOficios, oficiosNuevos } = __mod_oficios;
// 3.6: la Aldea de los Duendes (reemplaza al pueblo que fundabas en la 3.1)
const { sanearAldea, aldeaNueva, migrarDesdePueblo } = __mod_aldea;
