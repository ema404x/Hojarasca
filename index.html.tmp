const { GRILLA_EXPLORADA } = __mod_mapa;
const { LIMITE, sanearDistancia, sanearPlantas } = __mod_config;
const { sanearDesafio } = __mod_desafio_reglas;
const { sanearChinches } = __mod_chinches;
const { sanearTalados } = __mod_bosque;
const { sanearBase } = __mod_encargos_temporada;
const { sanearGrabaciones } = __mod_grabador;
const { sanearHuerta, desdeCanteroViejo, claveCantero } = __mod_huerta;
const { sanearGallineros } = __mod_gallinero;
const { sanearFeria } = __mod_feria;
const { sanearVisitas, visitasNuevas } = __mod_visitas;
const { sanearMajada, majadaNueva } = __mod_majada;
const { sanearCorral } = __mod_corral;
const { sanearCorreo, correoNuevo } = __mod_correo;
const { sanearTormenta, tormentaNueva } = __mod_tormenta;
const { sanearCaballo, caballoNuevo } = __mod_caballo;
// 2.8: lo personal (ropa, interfaz, bandera, recetas… ver personalizacion.js)
const { sanearPersonal } = __mod_personal_todo;
const { sanearComercio, comercioNuevo } = __mod_comercio;
// 2.9: dónde quedó el velero
const { sanearVela } = __mod_vela_reglas;
