    if (luzJugador.encendida) {
      _v.set(p.x, p.y + def.altura * a.m.esc * 0.9, p.z).sub(camara.position);
      const dl = _v.length();
      const cosL = dl > 0 ? _v.dot(dirCamara) / dl : 0;
      const giroCara = Math.atan2(dx, dz) - a.rumbo;
