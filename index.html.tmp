      if ((T.agua(nx, nz) && !T.agua(p.x, p.z)) || Math.abs(nx) > LIMITE || Math.abs(nz) > LIMITE) {
        if (a.desvioT <= 0) { a.desvio = (Math.random() < 0.5 ? -1 : 1) * 1.3; a.desvioT = 1.6; }
      } else {
        p.x = nx; p.z = nz;
        p.y = T.altura(p.x, p.z);
