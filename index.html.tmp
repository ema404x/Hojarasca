    } else {
      if (a.t <= 0) { a.t = 1.5 + Math.random() * 3; const r = Math.random() * Math.PI * 2, d = Math.random() * 3; a.objetivo = { x: centro.x + Math.cos(r) * d, z: centro.z + Math.sin(r) * d }; }
      caminar(a, a.objetivo.x, a.objetivo.z, deDia ? 1.4 : 0.4, dt);
