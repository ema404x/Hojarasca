const { COCINA, ESTACIONES, PLANOS_ESTACION, RECETA_PASOS, RECETAS_PASOS, estacionDeObra, estacionMovil, sanearCocina, sanearCoccion, opcionesEstacion, empezar, gastarIngredientes, avanzarCoccion, hacerPaso, pasoActual, avisoEstacion, humoDe, traeVecinos, elegirInvitados, lugaresAlrededor, FRASES_ASADO, FRASES_PERRO, sabe, aprender, ENSENAN, AL_ENSENAR, CAMBIOS_VECINOS, cambiosDe, cambiar, FRASES_CAMBIO, textoPide, pideCon, efectoDeComer, esComida, cuantoHay, alacenaDe, nombreCon, pistaReceta, INGREDIENTES, textoFaltan, sinTechoConLluvia } = __mod_cocina_pasos;
const { estaLibre, amistades, sumarAmistadDe, nombreCorto } = __mod_vecindad;
